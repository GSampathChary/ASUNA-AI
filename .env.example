# Asuna AI Environment Variables
APP_NAME=AsunaAI
PORT=8000
API_KEY=your_api_key_here
WEBSOCKET_URL=ws://localhost:8000/ws
# Keep this secret on the backend only; never put it in the web app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Optional alternative provider. Configure either Gemini or OpenAI, never keys in the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Generate a long random value during desktop-agent pairing. Do not share it with the browser.
ASUNA_AGENT_TOKEN=
# Comma-separated browser origins allowed to call the API.
# Example: https://asuna-ai.vercel.app,https://asuna-ai.pages.dev
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
